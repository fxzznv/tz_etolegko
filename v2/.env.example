# Адрес трекера Keitaro БЕЗ /admin и /admin_api/v1
KEITARO_URL=https://your-tracker.example.com

# Ключ Admin API v1: Maintenance → Users → Key for Admin API
# (или Account → API keys → Create API key)
KEITARO_API_KEY=your_api_key_here

# Демо-режим без реального трекера. По умолчанию выключен — раскомментируйте,
# только если нет доступа к Keitaro:
# KEITARO_MOCK=1

# SQLite по умолчанию; можно указать postgres://...
# DATABASE_URL=sqlite:///./adrobot.db
